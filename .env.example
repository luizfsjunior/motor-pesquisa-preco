TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEADLESS=true
# Com HEADLESS=false: Chrome abre minimizado (barra de tarefas)
BROWSER_START_MINIMIZED=true
DATABASE_URL=sqlite:///data/prices.db
LOG_LEVEL=INFO
# Sessão Shopee (gerada por: python -m app.cli shopee-login)
# SHOPEE_STORAGE_STATE_PATH=data/shopee_storage_state.json
# Perfil isolado (rode shopee-login SEM --chrome-profile antes): SHOPEE_PERSISTENT_PROFILE=true
# SHOPEE_PERSISTENT_PROFILE=false
# Navegador Shopee: chrome (padrão), firefox, brave, chromium
# Sem Firefox instalado o sistema usa Chrome automaticamente
SHOPEE_BROWSER=chrome
SHOPEE_INTERACTIVE=true
# Chrome real logado: scripts/start-chrome-cdp.bat + SHOPEE_CDP_URL=http://127.0.0.1:9222
# SHOPEE_CDP_STRICT=false   # false = se CDP cair, usa DuckDuckGo (plano B)
# SHOPEE_FALLBACK_ONLY=false  # true = só DDG/Bing/Google (GitHub Actions)
# SHOPEE_INTERACTIVE=false    # recomendado em VPS/CI
# Oracle VPS: deploy/oracle/env.vps.example + docs/07-deploy-oracle-cdp.md
# SCHEDULER_INTERVAL_MINUTES=15
