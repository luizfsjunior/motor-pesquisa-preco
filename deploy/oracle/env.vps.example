# Copie para .env na VPS: cp deploy/oracle/env.vps.example .env

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=sqlite:///data/prices.db
LOG_LEVEL=INFO
HEADLESS=true
BROWSER_START_MINIMIZED=true

# Opção 3 — Oracle VPS: Chrome no host, motor no Docker
SHOPEE_BROWSER=chrome
SHOPEE_CDP_URL=http://host.docker.internal:9222
# Se CDP cair, usa plano B (DDG+enrich) em vez de falhar o ciclo
SHOPEE_CDP_STRICT=false
SHOPEE_INTERACTIVE=false
SHOPEE_FALLBACK_ONLY=false

SCHEDULER_INTERVAL_MINUTES=240
